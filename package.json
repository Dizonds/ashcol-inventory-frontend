{
  "name": "ashcol-inventory-frontend-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Development and verification commands for the ASHCOL Inventory frontend.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "npm --prefix client ci",
    "start": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix client test --",
    "test:ci": "npm --prefix client test -- --watchAll=false --runInBand"
  }
}
